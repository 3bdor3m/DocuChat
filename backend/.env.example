# Server Configuration
PORT=8000
NODE_ENV=development
APP_NAME=DocuChat Backend

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/docuchat_db"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.txt,.md

# Google Gemini AI Configuration (REQUIRED)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=50

# Subscription Limits
FREE_FILE_LIMIT=5
FREE_MESSAGE_LIMIT=100
FREE_STORAGE_MB=100
BASIC_FILE_LIMIT=20
BASIC_MESSAGE_LIMIT=500
BASIC_STORAGE_MB=500
PREMIUM_FILE_LIMIT=100
PREMIUM_MESSAGE_LIMIT=-1
PREMIUM_STORAGE_MB=2000
